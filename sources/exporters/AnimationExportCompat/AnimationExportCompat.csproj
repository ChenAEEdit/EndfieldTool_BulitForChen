<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <PropertyGroup><RuntimeRoot Condition="'$(RuntimeRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\runtime\animation</RuntimeRoot></PropertyGroup>
  <ItemGroup>
    <Reference Include="AnimeStudio"><HintPath>$(RuntimeRoot)\AnimeStudio.dll</HintPath></Reference>
    <Reference Include="AnimeStudio.Utility"><HintPath>$(RuntimeRoot)\AnimeStudio.Utility.dll</HintPath></Reference>
    <Reference Include="AnimeStudio.FBXWrapper"><HintPath>$(RuntimeRoot)\AnimeStudio.FBXWrapper.dll</HintPath></Reference>
    <Reference Include="AnimeStudio.PInvoke"><HintPath>$(RuntimeRoot)\AnimeStudio.PInvoke.dll</HintPath></Reference>
    <Reference Include="Ruri.ACL"><HintPath>$(RuntimeRoot)\Ruri.ACL.dll</HintPath></Reference>
  </ItemGroup>
  <Import Project="..\RuntimeDependencies.props" />
</Project>
