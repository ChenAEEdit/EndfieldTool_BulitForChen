+#if NET10_0
+        private void DecodeEndfieldAclBuffer(Clip clip, AnimationClipBindingConstant bindings)
+        {
+            if (!game.Type.IsArknightsEndfield() || animationClip.m_AclCompressedBuffer == null)
+            {
+                return;
+            }
+
+            var buffer = animationClip.m_AclCompressedBuffer;
+            if ((buffer.TransformBufferData?.Length ?? 0) == 0 &&
+                (buffer.FloatBufferData?.Length ?? 0) == 0 &&
+                (buffer.RootMotionBufferData?.Length ?? 0) == 0)
+            {
+                return;
+            }
+            var transformDecoder = new AclDecompressor(buffer.TransformBufferData);
+            var floatDecoder = new AclFloatDecompressor(buffer.FloatBufferData);
+            if (!transformDecoder.IsValid)
+            {
+                throw new InvalidDataException($"Invalid Endfield transform ACL buffer in {animationClip.m_Name}.");
+            }
+
+            int floatBindingCount = bindings.genericBindings.Count(binding => binding.typeID != ClassIDType.Transform);
+            if (floatBindingCount > 0 && (!floatDecoder.IsValid || floatDecoder.NumTracks != floatBindingCount))
+            {
+                throw new InvalidDataException(
+                    $"Endfield float ACL track mismatch in {animationClip.m_Name}: " +
+                    $"bindings={floatBindingCount}, tracks={floatDecoder.NumTracks}.");
+            }
+
+            float sampleRate = animationClip.m_SampleRate > 0 ? animationClip.m_SampleRate : clip.m_DenseClip.m_SampleRate;
+            float duration = Math.Max(transformDecoder.Duration, floatDecoder.IsValid ? floatDecoder.Duration : 0.0f);
+            int frameCount = checked((int)MathF.Round(duration * sampleRate) + 1);
+            int curveCount = bindings.genericBindings.Sum(binding =>
+                binding.typeID == ClassIDType.Transform ? binding.GetDimension() : 1);
+            var samples = new float[checked(frameCount * curveCount)];
+
+            for (int frameIndex = 0; frameIndex < frameCount; frameIndex++)
+            {
+                float time = frameIndex / sampleRate;
+                if (!transformDecoder.Sample(time, out var transforms) || transforms == null)
+                {
+                    throw new InvalidDataException($"Failed to sample Endfield transform ACL buffer at {time} in {animationClip.m_Name}.");
+                }
+
+                float[] floatValues = Array.Empty<float>();
+                if (floatBindingCount > 0 && (!floatDecoder.Sample(time, out floatValues) || floatValues == null))
+                {
+                    throw new InvalidDataException($"Failed to sample Endfield float ACL buffer at {time} in {animationClip.m_Name}.");
+                }
+
+                int positionTrack = 0;
+                int rotationTrack = 0;
+                int scaleTrack = 0;
+                int floatTrack = 0;
+                int sampleOffset = frameIndex * curveCount;
+                int cursor = sampleOffset;
+
+                foreach (var binding in bindings.genericBindings)
+                {
+                    if (binding.typeID == ClassIDType.Transform)
+                    {
+                        switch (binding.attribute)
+                        {
+                            case 1:
+                                var translation = transforms[positionTrack++].Translation;
+                                samples[cursor++] = translation.X;
+                                samples[cursor++] = translation.Y;
+                                samples[cursor++] = translation.Z;
+                                break;
+                            case 2:
+                                var rotation = transforms[rotationTrack++].Rotation;
+                                samples[cursor++] = rotation.X;
+                                samples[cursor++] = rotation.Y;
+                                samples[cursor++] = rotation.Z;
+                                samples[cursor++] = rotation.W;
+                                break;
+                            case 3:
+                                var scale = transforms[scaleTrack++].Scale;
+                                samples[cursor++] = scale.X;
+                                samples[cursor++] = scale.Y;
+                                samples[cursor++] = scale.Z;
+                                break;
+                            default:
+                                throw new InvalidDataException(
+                                    $"Unsupported Endfield transform binding attribute {binding.attribute} in {animationClip.m_Name}.");
+                        }
+                    }
+                    else
+                    {
+                        samples[cursor++] = floatValues[floatTrack++];
+                    }
+                }
+
+                if (cursor != sampleOffset + curveCount)
+                {
+                    throw new InvalidDataException(
+                        $"Endfield ACL curve layout mismatch in {animationClip.m_Name}: " +
+                        $"wrote {cursor - sampleOffset}, expected {curveCount} values.");
+                }
+            }
+
+            clip.m_DenseClip.m_FrameCount = frameCount;
+            clip.m_DenseClip.m_CurveCount = checked((uint)curveCount);
+            clip.m_DenseClip.m_SampleRate = sampleRate;
+            clip.m_DenseClip.m_BeginTime = 0.0f;
+            clip.m_DenseClip.m_SampleArray = samples;
+            animationClip.m_Compressed = false;
+        }
+#endif
+
